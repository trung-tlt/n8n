#!/bin/bash
# cloud-init bootstrap for the n8n hackathon host. Runs once as root on first boot.
set -euo pipefail
exec > >(tee -a /var/log/n8n-bootstrap.log) 2>&1
echo "=== n8n hackathon bootstrap started $(date -Is) ==="

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y curl jq ca-certificates gzip

# Docker Engine + compose plugin
if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
usermod -aG docker ubuntu || true

# Layout
mkdir -p /opt/n8n/scripts
cd /opt/n8n

cat > teams.txt <<'EOF'
${teams}
EOF

cat > .config <<EOF
BASE_DOMAIN=${base_domain}
ACME_EMAIL=${acme_email}
N8N_IMAGE=${n8n_image}
TZ_NAME=${timezone}
EOF

echo "${gen_compose_b64}"  | base64 -d | gunzip > scripts/gen-compose.sh
echo "${reset_team_b64}"   | base64 -d | gunzip > scripts/reset-team.sh
echo "${reset_all_b64}"    | base64 -d | gunzip > scripts/reset-all.sh
chmod +x scripts/*.sh

# Render compose + Caddyfile, start everything. Each instance shows n8n's own
# "Set up owner account" screen to the first visitor — no accounts are pre-created.
./scripts/gen-compose.sh
docker compose pull --quiet
docker compose up -d

echo "=== n8n hackathon bootstrap finished $(date -Is) ==="
